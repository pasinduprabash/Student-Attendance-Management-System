<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="612.0" prefWidth="956.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.ijse.layered.fx.view.ManageClassesController">
   <children>
      <Label alignment="CENTER" layoutY="19.0" prefHeight="43.0" prefWidth="956.0" text="Manage Classes">
         <font>
            <Font name="System Bold" size="20.0" />
         </font>
      </Label>
      <Label fx:id="idLabel" layoutX="48.0" layoutY="82.0" prefHeight="43.0" prefWidth="213.0" text="Class ID : ">
         <font>
            <Font size="15.0" />
         </font>
      </Label>
      <Label fx:id="nameLabel" layoutX="495.0" layoutY="80.0" prefHeight="43.0" prefWidth="213.0" text="Course Name :">
         <font>
            <Font size="15.0" />
         </font>
      </Label>
      <Label fx:id="subLabel" layoutX="48.0" layoutY="138.0" prefHeight="43.0" prefWidth="213.0" text="Subject Name :">
         <font>
            <Font size="15.0" />
         </font>
      </Label>
      <Label fx:id="lecLabel" layoutX="48.0" layoutY="196.0" prefHeight="43.0" prefWidth="213.0" text="Lecture Name :">
         <font>
            <Font size="15.0" />
         </font>
      </Label>
      <TextField fx:id="idTxt" layoutX="190.0" layoutY="85.0" prefHeight="36.0" prefWidth="250.0">
         <font>
            <Font size="15.0" />
         </font>
      </TextField>
      <TextField fx:id="courseTxt" layoutX="641.0" layoutY="83.0" prefHeight="36.0" prefWidth="250.0">
         <font>
            <Font size="15.0" />
         </font>
      </TextField>
      <TextField fx:id="subjectTxt" layoutX="190.0" layoutY="142.0" prefHeight="36.0" prefWidth="250.0">
         <font>
            <Font size="15.0" />
         </font>
      </TextField>
      <TextField fx:id="lectureTxt" layoutX="190.0" layoutY="199.0" prefHeight="36.0" prefWidth="250.0">
         <font>
            <Font size="15.0" />
         </font>
      </TextField>
      <Button fx:id="saveBtn" layoutX="495.0" layoutY="200.0" mnemonicParsing="false" onAction="#saveClasses" prefHeight="36.0" prefWidth="123.0" text="Save">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
      <Button fx:id="updateBtn" layoutX="641.0" layoutY="200.0" mnemonicParsing="false" onAction="#updateClasses" prefHeight="36.0" prefWidth="123.0" text="Update">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
      <Button fx:id="deleteBtn" layoutX="787.0" layoutY="200.0" mnemonicParsing="false" onAction="#deleteClasses" prefHeight="36.0" prefWidth="123.0" text="Delete">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
      <Button fx:id="resetBtn" layoutX="495.0" layoutY="259.0" mnemonicParsing="false" onAction="#clear" prefHeight="36.0" prefWidth="123.0" text="Reset">
         <font>
            <Font name="System Bold" size="14.0" />
         </font>
      </Button>
      <TableView layoutX="42.0" layoutY="333.0" prefHeight="257.0" prefWidth="874.0">
        <columns>
            <TableColumn prefWidth="94.0" text="class_id" />
            <TableColumn prefWidth="361.0" text="course_name" />
            <TableColumn prefWidth="242.0" text="subject_name" />
            <TableColumn prefWidth="480.0" text="lecture_name" />
        </columns>
      </TableView>
      <Label fx:id="dateLabel" layoutX="48.0" layoutY="258.0" prefHeight="43.0" prefWidth="213.0" text="Date :">
         <font>
            <Font size="15.0" />
