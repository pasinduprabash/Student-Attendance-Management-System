<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="468.0" prefWidth="658.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.ijse.layered.fx.view.MainMenuController">
    <children>
        <VBox prefHeight="400.0" prefWidth="290.0">
            <children>
                <ImageView fitHeight="469.0" fitWidth="376.0" pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@image.jpg" />
                    </image>
                </ImageView>
            </children>
        </VBox>
        <Label fx:id="titleLabel" alignment="CENTER" contentDisplay="CENTER" layoutX="362.0" layoutY="26.0" prefHeight="40.0" prefWidth="296.0" text="Main Menu">
            <font>
                <Font name="System Bold" size="18.0" />
            </font>
        </Label>
        <Hyperlink fx:id="tradeMarkLabel" layoutX="375.0" layoutY="419.0" prefHeight="24.0" prefWidth="272.0" text="© 2025 Sample IT System. All rights reserved.">
            <font>
                <Font size="12.0" />
            </font>
        </Hyperlink>
      <Button fx:id="studentsBtn" layoutX="393.0" layoutY="88.0" mnemonicParsing="false" onAction="#navigateStudents" prefHeight="34.0" prefWidth="233.0" text="Manage Students">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Button>
      <Button fx:id="lecturesBtn" layoutX="393.0" layoutY="136.0" mnemonicParsing="false" onAction="#navigateLectures" prefHeight="34.0" prefWidth="233.0" text="Manage Lectures">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Button>
      <Button fx:id="coursesBtn" layoutX="393.0" layoutY="186.0" mnemonicParsing="false" onAction="#navigateCourses" prefHeight="34.0" prefWidth="233.0" text="Manage Courses">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Button>
      <Button fx:id="classesBtn" layoutX="393.0" layoutY="239.0" mnemonicParsing="false" onAction="#navigateClasses" prefHeight="34.0" prefWidth="233.0" text="Manage Classes">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Button>
      <Button fx:id="logOutBtn" layoutX="393.0" layoutY="347.0" mnemonicParsing="false" onAction="#logOut" prefHeight="34.0" prefWidth="233.0" text="Log Out">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Button>
      <Button fx:id="attendenceBtn" layoutX="393.0" layoutY="292.0" mnemonicParsing="false" onAction="#navigateAttendence" prefHeight="34.0" prefWidth="233.0" text="Manage Attendance">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Button>
    </children>
</AnchorPane>
