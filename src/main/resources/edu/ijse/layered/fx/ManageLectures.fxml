         </font>
      </Button>
      <Button fx:id="resetBtn" layoutX="717.0" layoutY="187.0" mnemonicParsing="false" onAction="#clear" prefHeight="38.0" prefWidth="129.0" text="Reset">
         <font>
            <Font name="System Bold" size="13.0" />
         </font>
      </Button>
      <TableView fx:id="detailsTabel" layoutX="55.0" layoutY="252.0" prefHeight="339.0" prefWidth="848.0">
        <columns>
            <TableColumn fx:id="idColmn" prefWidth="159.0" text="lect_id" />
            <TableColumn fx:id="nameColmn" prefWidth="357.0" text="lect_Name" />
            <TableColumn fx:id="contactColmn" prefWidth="331.0" text="contact_Number" />
        </columns>
